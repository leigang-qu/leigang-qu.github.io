{% if site.mapmyvisitors_id %}
  <style>
    .visits-map {
      width: 40%;
      max-width: 300px;
      margin: 2rem auto 0;
    }

    #mapmyvisitors {
      width: 100%;
    }

    @media (max-width: 768px) {
      .visits-map {
        width: 60%;
        max-width: 250px;
      }
    }

    @media (max-width: 480px) {
      .visits-map {
        width: 80%;
        max-width: 200px;
      }
    }
  </style>

  <div class="visits-map">
    <script
      type="text/javascript"
      id="mapmyvisitors"
      src="https://mapmyvisitors.com/map.js?d={{ site.mapmyvisitors_id }}&cl=ffffff&w=a"
    ></script>
  </div>
{% endif %}

{% if site.goatcounter_code %}
  <style>
    .visits-counter {
      text-align: center;
      font-size: 0.85rem;
      color: var(--global-text-color-light);
      margin-top: 0.5rem;
    }
  </style>

  <div class="visits-counter">Total visits: <span id="visits-total">–</span> &nbsp;·&nbsp; Last 30 days: <span id="visits-recent">–</span></div>

  <script
    data-goatcounter="https://{{ site.goatcounter_code }}.goatcounter.com/count"
    async
    src="//gc.zgo.at/count.js"
  ></script>
  <script>
    (function () {
      var base = 'https://{{ site.goatcounter_code }}.goatcounter.com/counter/TOTAL.json';
      var start = new Date(Date.now() - 30 * 24 * 3600 * 1000).toISOString().slice(0, 10);

      function show(url, id) {
        fetch(url)
          .then(function (res) {
            // GoatCounter returns 404 when there are no visits yet in the range
            if (res.status === 404) return { count: '0' };
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
          })
          .then(function (data) {
            document.getElementById(id).textContent = data.count;
          })
          .catch(function () {});
      }

      show(base, 'visits-total');
      show(base + '?start=' + start, 'visits-recent');
    })();
  </script>
{% endif %}
